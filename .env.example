# Copy this file to .env.local and fill in the three required values.
# .env.local is ignored by git. Never commit real keys.

# --- Required ---------------------------------------------------------------

# Postgres connection string with the pgvector extension available.
# On Neon, use the "pooled" connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Anthropic key: writes the answers. https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"

# OpenAI key: makes the embeddings (Anthropic has no embedding model).
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-REPLACE_ME"

# --- Optional: swap models --------------------------------------------------
# The values below are the defaults. Uncomment to change them.

# CHAT_MODEL="claude-sonnet-5-5"
# EMBEDDING_MODEL="text-embedding-3-small"
# If you change the embedding model, set its vector length here and run
# "npm run ingest" again. Old and new vectors cannot be compared.
# EMBEDDING_DIMENSIONS="1536"
